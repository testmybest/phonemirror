{
  "name": "phonemirror-desktop",
  "version": "1.0.0",
  "description": "PhoneMirror Desktop - Screen Mirror Receiver",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:win:portable": "electron-builder --win portable",
    "dev": "electron . --dev"
  },
  "keywords": ["screen-mirror", "webrtc", "android", "remote-control"],
  "author": "PhoneMirror Team",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "ws": "^8.16.0",
    "qrcode": "^1.5.3"
  },
  "build": {
    "appId": "com.phonemirror.desktop",
    "productName": "PhoneMirror",
    "copyright": "Copyright 2024 PhoneMirror Team",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PhoneMirror"
    },
    "portable": {
      "artifactName": "PhoneMirror-Portable-${version}.exe"
    }
  }
}
